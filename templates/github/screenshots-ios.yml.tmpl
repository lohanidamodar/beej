# Capture, frame and commit App Store screenshots with goldie.
#
# Manual only, and macOS — goldie drives an iOS simulator through `xcrun
# simctl`, which has no Linux equivalent. macOS minutes bill at 10x on a
# private repo, which is another reason this is not automatic.
#
#   1. builds a release simulator app
#   2. `goldie all` replays the argent flows, frames each capture with a
#      device bezel and headline, and checks the result against Apple's rules
#   3. commits the images where `deliver` uploads them from
#
# PREREQUISITE: argent flows. goldie replays flows from `.argent/flows`, named
# `store-<scene>` for each scene in screenshots/headlines.json. They do not
# exist until someone records them, which is a Mac-side job — see
# screenshots/README.md. Until then this workflow fails at the capture step,
# on purpose and with a clear message rather than a green run and no images.

name: Screenshots (iOS)

on:
  workflow_dispatch:
    inputs:
      locale:
        # App Store languages, which are not the Play ones — Apple accepts a
        # fixed list with no Nepali, and a directory it does not recognise is
        # rejected on upload.
        description: "App Store locale directory"
        type: choice
        default: en-US
        options:
<% #appStoreLocales %>
          - <% code %>
<% /appStoreLocales %>
      commit:
        description: "Commit the result back to the branch"
        type: boolean
        default: true

permissions:
  contents: write

jobs:
  screenshots:
    runs-on: macos-latest
    timeout-minutes: 90
    env:
      LOCALE: ${{ inputs.locale }}

    steps:
      - uses: actions/checkout@v7

      - name: Check the flows exist
        run: |
          if [ ! -d .argent/flows ] || [ -z "$(ls -A .argent/flows 2>/dev/null)" ]; then
            echo "::error::no argent flows in .argent/flows — goldie has nothing to replay."
            echo "Record them on a Mac first; see screenshots/README.md."
            exit 1
          fi
          ls -la .argent/flows

      - uses: subosito/flutter-action@v2
        with:
          flutter-version: "<% flutterVersion %>"
          channel: stable
          cache: true

      - uses: actions/setup-node@v4
        with:
          node-version: "20"

      - name: Install goldie and its tools
        run: |
          brew install ffmpeg
          npm i -g goldie @swmansion/argent

      - name: Build the simulator app
        # Release, because a debug build paints banners into the captures.
        run: |
          flutter pub get
          flutter build ios --simulator --release

      - name: Check the toolchain
        run: goldie doctor

      - name: Capture, frame and verify
        run: goldie all

      - name: Place the images
        env:
          DESTINATION: ios/fastlane/screenshots/${{ inputs.locale }}
        run: |
          set -euo pipefail
          src="out/$LOCALE"
          if [ ! -d "$src" ] || [ -z "$(ls -A "$src" 2>/dev/null)" ]; then
            echo "::error::goldie produced nothing in $src"
            exit 1
          fi
          # Replaced wholesale: a scene removed from headlines.json should
          # disappear from the listing too.
          rm -rf "$DESTINATION"
          mkdir -p "$DESTINATION"
          find "$src" -name '*.png' -exec cp {} "$DESTINATION/" \;
          ls -la "$DESTINATION"

      - name: Commit
        if: ${{ inputs.commit }}
        run: |
          git config user.name  "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add ios/fastlane/screenshots
          if git diff --staged --quiet; then
            echo "screenshots unchanged; nothing to commit"
            exit 0
          fi
          git commit -m "chore: refresh App Store screenshots (${LOCALE})"
          git push

      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: screenshots-ios-${{ inputs.locale }}
          path: out/
          if-no-files-found: warn
