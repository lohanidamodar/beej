/// Compile-time configuration.
///
/// Values can be overridden per build with `--dart-define`, which is how a
/// staging build points at a different backend without a code change:
///
/// ```sh
/// flutter build apk --dart-define=APPWRITE_ENDPOINT=https://staging/v1
/// ```
abstract final class AppConfig {
  static const String appName = '{{appName}}';

  /// The Android applicationId of the **release** build — the store deep link
  /// is built from it, so it must stay the published id.
  ///
  /// Not the id a debug build runs under, and not the iOS bundle id: Apple
  /// bans underscores, so the two differ whenever the project name has one.
  static const String androidApplicationId = '{{applicationId}}';

  static const String storeListingUrl =
      'https://play.google.com/store/apps/details?id={{applicationId}}';

{{#hasPrivacyPolicy}}
  /// Linked from About, and required by both stores before they will publish.
  static const String privacyPolicyUrl = '{{privacyPolicyUrl}}';
{{/hasPrivacyPolicy}}
{{#hasMoreApps}}
  static const String moreAppsUrl = '{{moreAppsUrl}}';
{{/hasMoreApps}}
{{#hasSupportEmail}}
  static const String supportEmail = '{{supportEmail}}';
{{/hasSupportEmail}}
  static const String legalese = '{{legalese}}';
{{#appwrite}}

  // --- Appwrite ---

  static const String appwriteEndpoint = String.fromEnvironment(
    'APPWRITE_ENDPOINT',
    defaultValue: '{{appwriteEndpoint}}',
  );

  static const String appwriteProjectId = String.fromEnvironment(
    'APPWRITE_PROJECT',
    defaultValue: '{{appwriteProjectId}}',
  );

  static const String appwriteDatabaseId = String.fromEnvironment(
    'APPWRITE_DATABASE',
    defaultValue: '{{appwriteDatabaseId}}',
  );
{{/appwrite}}
}
