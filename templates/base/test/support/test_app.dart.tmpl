/// Shared set-up for tests that run the whole app.
///
/// One place to pump the real app, so a new provider that needs overriding in
/// tests is added once rather than in every file.

/// Either side of the 600 breakpoint in core/util/responsive.dart.
const phone = Size(390, 844);
const desktop = Size(1440, 900);

/// A phone tall enough that every row of a long screen is laid out at once.
/// The accessibility guidelines only inspect what is on screen.
const tallPhone = Size(390, 2400);

/// Pump the real app at [size] and let it settle.
///
/// [platformTextScale] is the device's own text size; [settings] carries the
/// in-app one. The view and text scale are reset afterwards, because leaking
/// either into the next test makes failures depend on execution order.
Future<void> pumpApp(
  WidgetTester tester, {
  Size size = phone,
  AppSettings settings = const AppSettings(),
  double platformTextScale = 1.0,
  Analytics analytics = const NoopAnalytics(),
  UserFeedback userFeedback = const NoopUserFeedback(),
{{#appwrite}}
  bool signedIn = true,
{{/appwrite}}
{{#onboarding}}
  bool onboardingComplete = true,
  OnboardingStore? onboardingStore,
{{/onboarding}}
}) async {
  tester.view.devicePixelRatio = 1.0;
  tester.view.physicalSize = size;
  addTearDown(tester.view.resetPhysicalSize);
  addTearDown(tester.view.resetDevicePixelRatio);
  tester.platformDispatcher.textScaleFactorTestValue = platformTextScale;
  addTearDown(tester.platformDispatcher.clearTextScaleFactorTestValue);

  SharedPreferences.setMockInitialValues({});
  PackageInfo.setMockInitialValues(
    appName: '{{appName}}',
    packageName: '{{applicationId}}',
    version: '1.0.0',
    buildNumber: '1',
    buildSignature: '',
  );
  final preferences = await SharedPreferences.getInstance();

  await tester.pumpWidget(
    ProviderScope(
      overrides: [
        sharedPreferencesProvider.overrideWithValue(preferences),
        settingsControllerProvider.overrideWith(
          () => SettingsController(initial: settings),
        ),
        analyticsProvider.overrideWithValue(analytics),
        userFeedbackProvider.overrideWithValue(userFeedback),
{{#appwrite}}
        authControllerProvider.overrideWith(
          () => signedIn
              ? _SignedInAuthController()
              : _SignedOutAuthController(),
        ),
{{/appwrite}}
{{#onboarding}}
        onboardingControllerProvider.overrideWith(
          () => OnboardingController(
            initialComplete: onboardingComplete,
            store: onboardingStore,
          ),
        ),
{{/onboarding}}
      ],
      child: const {{pascalName}}App(),
    ),
  );
  await tester.pumpAndSettle();
}

/// Go to the Settings destination the way a user would: through the
/// navigation, opening the drawer first where it sits behind the hamburger.
Future<void> openSettings(WidgetTester tester) async {
  if (find.byIcon({{iconSettings}}).evaluate().isEmpty) {
    await tester.tap(find.byType(DrawerButton));
    await tester.pumpAndSettle();
  }
  await tester.tap(find.byIcon({{iconSettings}}).last);
  await tester.pumpAndSettle();
}

/// Push [path] over the shell, as a tap on a settings row would.
Future<void> openRoute(WidgetTester tester, String path) async {
  tester.element(find.byType(AppShell)).pushTo<void>(path);
  await tester.pumpAndSettle();
}
