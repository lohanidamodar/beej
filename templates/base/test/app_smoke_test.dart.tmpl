import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:shared_preferences/shared_preferences.dart';
import 'package:{{name}}/core/app.dart';
import 'package:{{name}}/core/settings/settings_controller.dart';

/// The app builds, routes to its first screen, and renders.
///
/// Deliberately shallow. Its job is to fail loudly when a change breaks
/// startup — a missing provider override, a bad route table, a theme that
/// throws — not to assert anything about a particular screen.
void main() {
  testWidgets('{{appName}} starts and renders its first screen', (
    tester,
  ) async {
    SharedPreferences.setMockInitialValues({});
    final preferences = await SharedPreferences.getInstance();

    await tester.pumpWidget(
      ProviderScope(
        overrides: [sharedPreferencesProvider.overrideWithValue(preferences)],
        child: const {{pascalName}}App(),
      ),
    );
    await tester.pumpAndSettle();

    expect(tester.takeException(), isNull);
  });
}
