# ------------------------------------------------------------------
# .env.android — Android release environment for {{appName}}.
#
# Generated by beej. CONTAINS SECRETS — gitignored, never commit it.
#
# Usage:
#   source .env.android && (cd android && bundle exec fastlane internal)
# ------------------------------------------------------------------

# ---- App identity ----
export APP_IDENTIFIER="{{applicationId}}"

# ---- Google Play service account ----
# The org-wide service-account JSON. Point this at wherever you keep it.
export PLAY_STORE_JSON_KEY_PATH="${PLAY_STORE_JSON_KEY_PATH:-}"

# ---- Signing keystore ----
export ANDROID_KEYSTORE_PATH="{{keystoreFile}}"
export ANDROID_KEYSTORE_PASSWORD="{{keystoreStorePassword}}"
export ANDROID_KEY_ALIAS="{{keystoreAlias}}"
export ANDROID_KEY_PASSWORD="{{keystoreKeyPassword}}"

# Uncomment for the very first upload to a draft Play listing.
# export SUPPLY_RELEASE_STATUS="draft"
