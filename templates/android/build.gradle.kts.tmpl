import java.util.Properties

plugins {
    id("com.android.application")
    // The Flutter Gradle Plugin must be applied after the Android and Kotlin plugins.
    id("dev.flutter.flutter-gradle-plugin")
}

// Release signing, loaded from android/key.properties when that file exists.
// It is gitignored and generated by keytool. Keys: storeFile, storePassword,
// keyAlias, keyPassword. Without it the release build falls back to debug
// signing, so `flutter run --release` still works for anyone without the
// keystore — which is every fresh clone and every CI job that only builds.
val keystoreProperties = Properties()
val keystorePropertiesFile = rootProject.file("key.properties")
val hasReleaseKeystore = keystorePropertiesFile.exists()
if (hasReleaseKeystore) {
    keystorePropertiesFile.inputStream().use { keystoreProperties.load(it) }
}

android {
    namespace = "{{applicationId}}"
    compileSdk = flutter.compileSdkVersion
    ndkVersion = flutter.ndkVersion

    compileOptions {
{{#notifications}}
        // flutter_local_notifications uses java.time APIs that need core
        // library desugaring on the minSdk levels we support.
        isCoreLibraryDesugaringEnabled = true
{{/notifications}}
        sourceCompatibility = JavaVersion.VERSION_17
        targetCompatibility = JavaVersion.VERSION_17
    }

    defaultConfig {
        applicationId = "{{applicationId}}"
        minSdk = flutter.minSdkVersion
        targetSdk = flutter.targetSdkVersion
        versionCode = flutter.versionCode
        versionName = flutter.versionName

        // The launcher label. The manifest reads it as ${appLabel} rather
        // than hard-coding a name, so a build type can override it below —
        // and so the name on the launcher is the app's display name instead
        // of the Dart package name flutter create writes there.
        manifestPlaceholders["appLabel"] = "{{appName}}"
    }

    signingConfigs {
        if (hasReleaseKeystore) {
            create("release") {
                keyAlias = keystoreProperties["keyAlias"] as String
                keyPassword = keystoreProperties["keyPassword"] as String
                storeFile = (keystoreProperties["storeFile"] as String?)?.let { file(it) }
                storePassword = keystoreProperties["storePassword"] as String
            }
        }
    }

    buildTypes {
{{#devSuffix}}
        // Everything that is not the store build installs under its own
        // applicationId, so it sits *beside* the copy installed from Play
        // rather than replacing it. Testing a change no longer costs you the
        // real app and its data.
        //
        // `namespace` above is deliberately not suffixed: that is the R class
        // package, not the install id, and moving it would break resource
        // references. AppConfig.androidApplicationId is not suffixed either —
        // the market:// link has to reach the published app.
        //
        // profile has to be named explicitly. The Flutter Gradle Plugin
        // creates it with initWith(debug) while the plugin is being applied,
        // which is before this block runs, so it does not inherit what is set
        // on debug here. getByName fails the build if a future Flutter stops
        // creating it, which is the right outcome — silently dropping the
        // suffix is how a debug build ends up overwriting a store install.
        debug {
            applicationIdSuffix = "{{devIdSuffix}}"
            manifestPlaceholders["appLabel"] = "{{devAppLabel}}"
        }

        getByName("profile") {
            applicationIdSuffix = "{{devIdSuffix}}"
            manifestPlaceholders["appLabel"] = "{{devAppLabel}}"
        }

{{/devSuffix}}
        release {
            signingConfig = if (hasReleaseKeystore) {
                signingConfigs.getByName("release")
            } else {
                signingConfigs.getByName("debug")
            }
        }
    }
}

kotlin {
    compilerOptions {
        jvmTarget = org.jetbrains.kotlin.gradle.dsl.JvmTarget.JVM_17
    }
}

flutter {
    source = "../.."
}
{{#notifications}}

dependencies {
    coreLibraryDesugaring("com.android.tools:desugar_jdk_libs:2.1.4")
}
{{/notifications}}
