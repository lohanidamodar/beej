{{#picons}}
import 'package:picons/picons.dart';
{{/picons}}

{{#tabs}}
import '../{{id}}/{{id}}_screen.dart';
{{/tabs}}
import '../../core/theme/tokens.dart';
import '../../core/util/responsive.dart';
