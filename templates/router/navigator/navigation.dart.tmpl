import 'package:material_ui/material_ui.dart';

/// Navigation verbs, so screens never depend on how routing is wired.
///
/// The go_router build of this app ships a different file with the same API;
/// swapping routers means rewriting this and nothing else.
extension AppNavigation on BuildContext {
  /// Replace everything above the shell and show [path].
  void goTo(String path) =>
      Navigator.of(this).pushNamedAndRemoveUntil(path, (route) => route.isFirst);

  /// Push on top of the current screen.
  Future<T?> pushTo<T>(String path) => Navigator.of(this).pushNamed<T>(path);

  /// Pop if there is anything to pop.
  void back() {
    final navigator = Navigator.of(this);
    if (navigator.canPop()) navigator.pop();
  }
}
