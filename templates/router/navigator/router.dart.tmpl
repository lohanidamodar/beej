/// Root navigator key, so code outside the widget tree (notification taps,
/// the update flow) can navigate.
final GlobalKey<NavigatorState> rootNavigatorKey = GlobalKey<NavigatorState>();

/// What the app shows first.
{{#appwrite}}
///
/// Gates on auth: the shell only appears once there is a session. With no
/// router-level redirect available, this widget is the equivalent seam.
class AppRoot extends ConsumerWidget {
  const AppRoot({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final auth = ref.watch(authControllerProvider);
    return auth.when(
      loading: () => const Scaffold(body: LoadingView()),
      error: (_, _) => const SignInScreen(),
      data: (user) => user == null ? const SignInScreen() : const AppShell(),
    );
  }
}
