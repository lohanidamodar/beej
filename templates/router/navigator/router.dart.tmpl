/// Named routes pushed over the shell.
///
/// Destinations inside the shell are not here: they are branches of the
/// [AppShell]'s IndexedStack, switched by index rather than by route.
Route<dynamic>? generateRoute(RouteSettings settings) {
  return switch (settings.name) {
    Routes.about => MaterialPageRoute<void>(
      builder: (_) => const AboutScreen(),
      settings: settings,
    ),
{{#appwrite}}
    Routes.signIn => MaterialPageRoute<void>(
      builder: (_) => const SignInScreen(),
      settings: settings,
    ),
    Routes.signUp => MaterialPageRoute<void>(
      builder: (_) => const SignUpScreen(),
      settings: settings,
    ),
{{/appwrite}}
    // Unknown route: let Navigator fall through to its own error handling
    // rather than silently showing the wrong screen.
    _ => null,
  };
}
