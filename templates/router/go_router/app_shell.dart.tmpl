/// One navigation destination.
class ShellDestination {
  const ShellDestination({required this.label, required this.icon});

  final String label;
  final IconData icon;
}

/// The app's navigation chrome.
///
/// Owns the [Scaffold], the [AppBar] and the navigation surfaces; destinations
/// supply body content only. That split is what lets the drawer be reachable
/// from every destination — a nested Scaffold would capture the hamburger and
/// find no drawer on it.
///
/// Each navigation surface and the content area is its own
/// [FocusTraversalGroup], so Tab finishes the navigation before it enters the
/// content. Without them, Tab follows reading order, row by row across the
/// whole window, and once a screen has something focusable level with the
/// top of the navigation (a search field, a row of filters) it alternates
/// between the two.
///
/// Adapts by width: {{#hasTabs}}a bottom bar on a phone, a rail once there is room{{/hasTabs}}{{#drawerOnly}}a modal drawer on a phone, a permanent one once there is room{{/drawerOnly}}.
class AppShell extends StatelessWidget {
  const AppShell({required this.navigationShell, super.key});

  final StatefulNavigationShell navigationShell;

  /// Destinations, in branch order. Settings is always last — the router
  /// builds its branches in exactly this order.
  static List<ShellDestination> destinationsOf(BuildContext context) {
    final l10n = AppLocalizations.of(context);
    return [
{{#tabs}}
      ShellDestination(label: l10n.{{l10nKey}}, icon: {{icon}}),
{{/tabs}}
      ShellDestination(label: l10n.navSettings, icon: {{iconSettings}}),
    ];
  }

  void _go(int index) {
    navigationShell.goBranch(
      index,
      // Tapping the active destination returns to that branch's root, which
      // is what every platform's tab bar does.
      initialLocation: index == navigationShell.currentIndex,
    );
  }

  @override
  Widget build(BuildContext context) {
    final destinations = destinationsOf(context);
    final index = navigationShell.currentIndex;
    final useRail = context.useRail;
{{#drawerOnly}}
    // Inline once there is room for it, modal behind the hamburger otherwise.
    // The drawer widens with the text size so a label still fits at 200%, and
    // a wide window whose text is that large gets the modal drawer rather
    // than one that crowds out the content.
    final drawerWidth = MediaQuery.textScalerOf(
      context,
    ).scale(_inlineDrawerWidth);
    final inlineDrawer = useRail && drawerWidth <= context.screenWidth / 3;
{{/drawerOnly}}

    return Scaffold(
      appBar: AppBar(title: Text(destinations[index].label)),
{{#hasDrawer}}
      // Modal on a phone; the wide layout below shows it inline instead.
      drawer: {{#drawerOnly}}inlineDrawer{{/drawerOnly}}{{^drawerOnly}}useRail{{/drawerOnly}} ? null : _AppDrawer(
        destinations: destinations,
        selectedIndex: index,
        onSelected: (i) {
          Navigator.of(context).pop();
          _go(i);
        },
      ),
{{/hasDrawer}}
      body: Row(
        children: [
{{#hasTabs}}
          if (useRail) ...[
            FocusTraversalGroup(
              child: NavigationRail(
                selectedIndex: index,
                onDestinationSelected: _go,
                labelType: context.isExpanded
                    ? NavigationRailLabelType.none
                    : NavigationRailLabelType.all,
                extended: context.isExpanded,
                destinations: [
                  for (final destination in destinations)
                    NavigationRailDestination(
                      icon: Icon(destination.icon),
                      label: Text(destination.label),
                    ),
                ],
              ),
            ),
            const VerticalDivider(width: 1),
          ],
{{/hasTabs}}
{{#drawerOnly}}
          if (inlineDrawer) ...[
            SizedBox(
              width: drawerWidth,
              child: FocusTraversalGroup(
                child: _AppDrawer(
                  destinations: destinations,
                  selectedIndex: index,
                  onSelected: _go,
                ),
              ),
            ),
            const VerticalDivider(width: 1),
          ],
{{/drawerOnly}}
          Expanded(child: FocusTraversalGroup(child: navigationShell)),
        ],
      ),
{{#hasTabs}}
      bottomNavigationBar: useRail
          ? null
          : FocusTraversalGroup(
              child: NavigationBar(
                selectedIndex: index,
                onDestinationSelected: _go,
                destinations: [
                  for (final destination in destinations)
                    NavigationDestination(
                      icon: Icon(destination.icon),
                      label: destination.label,
                    ),
                ],
              ),
            ),
{{/hasTabs}}
    );
  }
}
{{#drawerOnly}}

/// The inline drawer's width at the default text size.
const double _inlineDrawerWidth = 280;
{{/drawerOnly}}
{{#hasDrawer}}

class _AppDrawer extends StatelessWidget {
  const _AppDrawer({
    required this.destinations,
    required this.selectedIndex,
    required this.onSelected,
  });

  final List<ShellDestination> destinations;
  final int selectedIndex;
  final ValueChanged<int> onSelected;

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    return NavigationDrawer(
      selectedIndex: selectedIndex,
      onDestinationSelected: onSelected,
      children: [
        Padding(
          padding: const EdgeInsets.fromLTRB(
            Spacing.xl,
            Spacing.xl,
            Spacing.lg,
            Spacing.lg,
          ),
          child: Text(
            AppLocalizations.of(context).appTitle,
            style: theme.textTheme.titleLarge,
          ),
        ),
        for (final destination in destinations)
          NavigationDrawerDestination(
            icon: Icon(destination.icon),
            label: Text(destination.label),
          ),
      ],
    );
  }
}
{{/hasDrawer}}
